<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- List View -->
    <record id="bike_view_list" model="ir.ui.view">
        <field name="name">bike.workshop.bike.list</field>
        <field name="model">bike.workshop.bike</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="brand"/>
                <field name="bike_type"/>
                <field name="purchase_date"/>
                <field name="last_service_date"/>
                <field name="daily_rental_price"/>
                <field name="wheel_size"/>
                <field name="rental_count"/>
            </list>
        </field>
    </record>


    <!-- Form View -->
    <record id="bike_view_form" model="ir.ui.view">
        <field name="name">bike.workshop.bike.form</field>
        <field name="model">bike.workshop.bike</field>
        <field name="arch" type="xml">
            <form>

                <sheet>

                    <!-- Smart Button -->
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_rentals"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-calendar"
                        >
                            <field
                                name="rental_count"
                                widget="statinfo"
                                string="Rentals"
                            />
                        </button>
                    </div>

                    <group>
                        <field name="name"/>
                        <field name="brand"/>
                        <field name="bike_type"/>
                        <field name="purchase_date"/>
                        <field name="last_service_date"/>
                        <field name="assigned_mechanic_id"/>
                        <field name="service_notes"/>
                        <field name="daily_rental_price"/>
                        <field name="wheel_size"/>
                    </group>

                </sheet>

            </form>
        </field>
    </record>


    <!-- Action -->
    <record id="bike_action" model="ir.actions.act_window">
        <field name="name">Bikes</field>
        <field name="res_model">bike.workshop.bike</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- Menu -->
    <menuitem
        id="bike_workshop_menu_root"
        name="Bike Workshop"
    />

    <menuitem
        id="bike_workshop_menu_bikes"
        name="Bikes"
        parent="bike_workshop_menu_root"
        action="bike_action"
    />

</odoo>

