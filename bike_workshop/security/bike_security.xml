<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="group_bike_workshop_staff" model="res.groups">
        <field name="name">Workshop Staff</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="bike_workshop_rental_portal_rule" model="ir.rule">
        <field name="name">Portal Users: Own Rentals Only</field>
        <field name="model_id" ref="model_bike_workshop_rental"/>
        <field name="domain_force">
            [('customer_id', '=', user.partner_id.id)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>