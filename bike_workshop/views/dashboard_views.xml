<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="bike_workshop_dashboard_view_form" model="ir.ui.view">
        <field name="name">bike.workshop.dashboard.form</field>
        <field name="model">bike.workshop.dashboard</field>

        <field name="arch" type="xml">

            <form string="Workshop Dashboard" create="0" edit="0" delete="0">

                <sheet>

                    <div
                        style="
                            padding: 25px;
                            background-color: #DEF2C9;
                            border-radius: 12px;
                            margin-bottom: 25px;
                        "
                    >
                        <h1
                            style="
                                color: #404040;
                                margin: 0;
                                font-size: 30px;
                                font-weight: bold;
                            "
                        >
                            Workshop Operations Dashboard
                        </h1>

                        <div
                            style="
                                color: #666666;
                                font-size: 15px;
                                margin-top: 6px;
                            "
                        >
                            Overview of today's workshop operations
                        </div>
                    </div>

                    <div class="row">

                        <div class="col-lg-4 col-md-6 mb-4">

                            <div
                                style="
                                    background-color: #F2F2F2;
                                    border: 2px solid #9FBF6F;
                                    border-radius: 14px;
                                    padding: 25px;
                                    min-height: 270px;
                                    box-shadow: 0 3px 8px rgba(64,64,64,0.10);
                                    text-align: center;
                                "
                            >

                                <div
                                    style="
                                        font-size: 45px;
                                        color: #8EBF45;
                                        margin-bottom: 12px;
                                    "
                                >
                                    <i class="fa fa-bicycle"/>
                                </div>

                                <div
                                    style="
                                        font-size: 19px;
                                        font-weight: bold;
                                        color: #404040;
                                        margin-bottom: 10px;
                                    "
                                >
                                    Active Rentals Today
                                </div>

                                <div
                                    style="
                                        font-size: 38px;
                                        font-weight: bold;
                                        color: #8EBF45;
                                        margin-bottom: 18px;
                                    "
                                >
                                    <field
                                        name="active_rentals_today"
                                        nolabel="1"
                                    />
                                </div>

                                <button
                                    name="action_open_active_rentals"
                                    type="object"
                                    class="btn btn-workshop-green"
                                >
                                    View Rentals
                                </button>

                            </div>

                        </div>

                        <div class="col-lg-4 col-md-6 mb-4">

                            <div
                                style="
                                    background-color: #DEF2C9;
                                    border: 2px solid #9FBF6F;
                                    border-radius: 14px;
                                    padding: 25px;
                                    min-height: 270px;
                                    box-shadow: 0 3px 8px rgba(64,64,64,0.10);
                                    text-align: center;
                                "
                            >

                                <div
                                    style="
                                        font-size: 45px;
                                        color: #8EBF45;
                                        margin-bottom: 12px;
                                    "
                                >
                                    <i class="fa fa-calendar"/>
                                </div>

                                <div
                                    style="
                                        font-size: 19px;
                                        font-weight: bold;
                                        color: #404040;
                                        margin-bottom: 10px;
                                    "
                                >
                                    Returns Due Today
                                </div>

                                <div
                                    style="
                                        font-size: 38px;
                                        font-weight: bold;
                                        color: #8EBF45;
                                        margin-bottom: 18px;
                                    "
                                >
                                    <field
                                        name="returns_due_today"
                                        nolabel="1"
                                    />
                                </div>

                                <button
                                    name="action_open_returns_due"
                                    type="object"

                                  class="btn btn-workshop-green"
                                >
                                    View Returns
                                </button>

                            </div>

                        </div>

                        <div class="col-lg-4 col-md-6 mb-4">

                            <div
                                style="
                                    background-color: #F2F2F2;
                                    border: 2px solid #9FBF6F;
                                    border-radius: 14px;
                                    padding: 25px;
                                    min-height: 270px;
                                    box-shadow: 0 3px 8px rgba(64,64,64,0.10);
                                    text-align: center;
                                "
                            >

                                <div
                                    style="
                                        font-size: 45px;
                                        color: #9FBF6F;
                                        margin-bottom: 12px;
                                    "
                                >
                                    <i class="fa fa-wrench"/>
                                </div>

                                <div
                                    style="
                                        font-size: 19px;
                                        font-weight: bold;
                                        color: #404040;
                                        margin-bottom: 10px;
                                    "
                                >
                                    Repairs In Progress
                                </div>

                                <div
                                    style="
                                        font-size: 38px;
                                        font-weight: bold;
                                        color: #8EBF45;
                                        margin-bottom: 18px;
                                    "
                                >
                                    <field
                                        name="repairs_in_progress"
                                        nolabel="1"
                                    />
                                </div>

                                <button
                                    name="action_open_repairs_in_progress"
                                    type="object"
                                    class="btn btn-workshop-green"
                                >
                                    View Repairs
                                </button>

                            </div>

                        </div>

                    </div>

                </sheet>

            </form>

        </field>
    </record>

    <record id="bike_workshop_dashboard_record" model="bike.workshop.dashboard"/>

    <record id="action_bike_workshop_dashboard" model="ir.actions.act_window">
        <field name="name">Workshop Dashboard</field>
        <field name="res_model">bike.workshop.dashboard</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="bike_workshop_dashboard_record"/>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_bike_workshop_dashboard"
        name="Dashboard"
        parent="bike_workshop_menu_root"
        action="action_bike_workshop_dashboard"
        sequence="1"
    />

</odoo>