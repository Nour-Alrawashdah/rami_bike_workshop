<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <template id="report_rental_agreement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="rental">
                <t t-call="web.external_layout" t-lang="rental.customer_id.lang">

                    <div class="page" dir="rtl" style="direction: rtl; text-align: right;">

                        <h2 style="text-align: right;">Rental Agreement</h2>

                        <div class="row mt-4" style="direction: rtl;">
                            <div class="col-6">
                                <strong>Rental Reference:</strong>
                                <span t-field="rental.reference"/>
                            </div>

                            <div class="col-6">
                                <strong>Status:</strong>
                                <span t-field="rental.state"/>
                            </div>
                        </div>

                        <h4 class="mt-4" style="text-align: right;">Customer Information</h4>

                        <div class="row" style="direction: rtl;">
                            <div class="col-6">
                                <strong>Customer:</strong>
                                <span t-field="rental.customer_id"/>
                            </div>
                        </div>

                        <h4 class="mt-4" style="text-align: right;">Rental Information</h4>

                        <table class="table table-sm" style="direction: rtl; text-align: right;">
                            <tbody>
                                <tr>
                                    <td style="text-align: right;">
                                        <strong>Bike</strong>
                                    </td>
                                    <td style="text-align: right;">
                                        <span t-field="rental.bike_id"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="text-align: right;">
                                        <strong>Start Date</strong>
                                    </td>
                                    <td style="text-align: right;">
                                        <span t-field="rental.start_date"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="text-align: right;">
                                        <strong>Expected Return Date</strong>
                                    </td>
                                    <td style="text-align: right;">
                                        <span t-field="rental.expected_return_date"/>
                                    </td>
                                </tr>

                                <tr t-if="rental.actual_return_date">
                                    <td style="text-align: right;">
                                        <strong>Actual Return Date</strong>
                                    </td>
                                    <td style="text-align: right;">
                                        <span t-field="rental.actual_return_date"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="text-align: right;">
                                        <strong>Rental Duration</strong>
                                    </td>
                                    <td style="text-align: right;">
                                        <span t-field="rental.rental_duration"/>
                                        days
                                    </td>
                                </tr>

                                <tr>
                                    <td style="text-align: right;">
                                        <strong>Daily Rental Price</strong>
                                    </td>
                                    <td style="text-align: right;">
                                        <span t-field="rental.daily_rental_price"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="text-align: right;">
                                        <strong>Total Rental Amount</strong>
                                    </td>
                                    <td style="text-align: right;">
                                        <span t-field="rental.total_rental_amount"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                    </div>

                </t>
            </t>
        </t>
    </template>

</odoo>
