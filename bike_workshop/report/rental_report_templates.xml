<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <template id="report_rental_agreement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="rental">
                <t t-call="web.external_layout" t-lang="rental.customer_id.lang">

                    <div class="page"
                         style="font-family: Arial, sans-serif; color: #404040; background-color: #ffffff; padding: 20px;">

                        <!-- Header -->
                        <div style="
                            background-color: #e8e8e8;
                            border-inline-start: 5px solid #8EBF45;
                            padding: 20px 24px;
                            margin-bottom: 25px;
                            box-shadow: 0 3px 8px rgba(64,64,64,0.10);
                        ">
                            <h2 style="
                                margin: 0;
                                color: #404040;
                                font-size: 26px;
                                font-weight: 700;
                            ">
                                Rental Agreement
                            </h2>
                        </div>

                        <!-- Rental Reference -->
                        <div style="
                            background-color: #eeeeee;
                            border-inline-start: 3px solid #8EBF45;
                            padding: 12px 16px;
                            margin-bottom: 10px;
                            box-shadow: 0 3px 8px rgba(64,64,64,0.10);
                        ">
                            <strong style="color: #404040;">
                                Rental Reference:
                            </strong>
                            <span t-field="rental.reference"/>
                        </div>

                        <!-- Status -->
                        <div style="
                            background-color: #eeeeee;
                            border-inline-start: 3px solid #8EBF45;
                            padding: 12px 16px;
                            margin-bottom: 25px;
                            box-shadow: 0 3px 8px rgba(64,64,64,0.10);
                        ">
                            <strong style="color: #404040;">
                                Status:
                            </strong>
                            <span t-field="rental.state"/>
                        </div>

                        <!-- Customer Information -->
                        <div style="
                            border-bottom: 2px solid #8EBF45;
                            padding-bottom: 8px;
                            margin-bottom: 15px;
                        ">
                            <h4 style="
                                margin: 0;
                                color: #404040;
                                font-size: 18px;
                            ">
                                Customer Information
                            </h4>
                        </div>

                        <!-- Customer -->
                        <div style="
                            background-color: #eeeeee;
                            border-inline-start: 3px solid #8EBF45;
                            padding: 12px 16px;
                            margin-bottom: 25px;
                            box-shadow: 0 3px 8px rgba(64,64,64,0.10);
                        ">
                            <strong style="color: #404040;">
                                Customer:
                            </strong>
                            <span t-field="rental.customer_id"/>
                        </div>

                        <!-- Rental Information -->
                        <div style="
                            border-bottom: 2px solid #8EBF45;
                            padding-bottom: 8px;
                            margin-bottom: 15px;
                        ">
                            <h4 style="
                                margin: 0;
                                color: #404040;
                                font-size: 18px;
                            ">
                                Rental Information
                            </h4>
                        </div>

                        <!-- Bike -->
                        <div style="
                            background-color: #eeeeee;
                            border-inline-start: 3px solid #8EBF45;
                            padding: 12px 16px;
                            margin-bottom: 10px;
                            box-shadow: 0 3px 8px rgba(64,64,64,0.10);
                        ">
                            <strong>Bike</strong>
                            <span style="margin-inline-start: 8px;">
                                <span t-field="rental.bike_id"/>
                            </span>
                        </div>

                        <!-- Start Date -->
                        <div style="
                            background-color: #eeeeee;
                            border-inline-start: 3px solid #8EBF45;
                            padding: 12px 16px;
                            margin-bottom: 10px;
                            box-shadow: 0 3px 8px rgba(64,64,64,0.10);
                        ">
                            <strong>Start Date</strong>
                            <span style="margin-inline-start: 8px;">
                                <span t-field="rental.start_date"/>
                            </span>
                        </div>

                        <!-- Expected Return Date -->
                        <div style="
                            background-color: #eeeeee;
                            border-inline-start: 3px solid #8EBF45;
                            padding: 12px 16px;
                            margin-bottom: 10px;
                            box-shadow: 0 3px 8px rgba(64,64,64,0.10);
                        ">
                            <strong>Expected Return Date</strong>
                            <span style="margin-inline-start: 8px;">
                                <span t-field="rental.expected_return_date"/>
                            </span>
                        </div>

                        <!-- Actual Return Date -->
                        <div t-if="rental.actual_return_date"
                             style="
                                background-color: #eeeeee;
                                border-inline-start: 3px solid #8EBF45;
                                padding: 12px 16px;
                                margin-bottom: 10px;
                                box-shadow: 0 3px 8px rgba(64,64,64,0.10);
                             ">
                            <strong>Actual Return Date</strong>
                            <span style="margin-inline-start: 8px;">
                                <span t-field="rental.actual_return_date"/>
                            </span>
                        </div>

                        <!-- Rental Duration -->
                        <div style="
                            background-color: #eeeeee;
                            border-inline-start: 3px solid #8EBF45;
                            padding: 12px 16px;
                            margin-bottom: 10px;
                            box-shadow: 0 3px 8px rgba(64,64,64,0.10);
                        ">
                            <strong>Rental Duration</strong>
                            <span style="margin-inline-start: 8px;">
                                <span t-field="rental.rental_duration"/>
                                days
                            </span>
                        </div>

                        <!-- Daily Rental Price -->
                        <div style="
                            background-color: #eeeeee;
                            border-inline-start: 3px solid #8EBF45;
                            padding: 12px 16px;
                            margin-bottom: 10px;
                            box-shadow: 0 3px 8px rgba(64,64,64,0.10);
                        ">
                            <strong>Daily Rental Price</strong>
                            <span style="margin-inline-start: 8px;">
                                <span t-field="rental.daily_rental_price"/>
                            </span>
                        </div>

                        <!-- Total Rental Amount -->
                        <div style="
                            background-color: #f3f8ec;
                            border: 2px solid #8EBF45;
                            padding: 16px;
                            margin-top: 18px;
                            box-shadow: 0 3px 8px rgba(64,64,64,0.10);
                        ">
                            <strong style="
                                color: #404040;
                                font-size: 16px;
                            ">
                                Total Rental Amount
                            </strong>

                            <span style="
                                margin-inline-start: 8px;
                                color: #8EBF45;
                                font-size: 20px;
                                font-weight: 700;
                            ">
                                <span t-field="rental.total_rental_amount"/>
                            </span>
                        </div>

                    </div>

                </t>
            </t>
        </t>
    </template>

</odoo>
